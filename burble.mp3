}

</span><span class="ͼ13">nav</span><span> </span><span class="ͼ13">a</span><span> {
    color: </span><span class="ͼy">white</span><span>;
    text-decoration: </span><span class="ͼy">none</span><span>;
    margin: </span><span class="ͼy">0</span><span> </span><span class="ͼy">20</span><span class="ͼv">px</span><span>;
    font-size: </span><span class="ͼy">18</span><span class="ͼv">px</span><span>;
}

</span><span class="ͼ13">nav</span><span> </span><span class="ͼ13">a</span><span>:</span><span class="ͼ10">hover</span><span> {
