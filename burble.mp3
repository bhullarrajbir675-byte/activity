card_v2_personalized_ads_mvp_1\",\"label\":\"Personalized Ads MVP 1\"},{\"label\":\"Personalized Ads MVP 2\",\"key\":\"image_card_v2_personalized_ads_mvp_2\"},{\"label\":\"Dogfood business agent\",\"key\":\"test_agent_5\"},{\"label\":\"Expedia - Business Agent\",\"key\":\"expedia_business_agent\"},{\"key\":\"expedia_prod_agent\",\"label\":\"Expedia Prod Agent\"},{\"key\":\"homh_prod_agent\",\"label\":\"Homh Prod Agent\"},{\"label\":\"Wayfair Prod Agent\",\"key\":\"wayfair_prod_agent\"},{\"key\":\"pottery_barn_prod_agent\",\"label\":\"Pottery Barn Prod Agent\"},{\"key\":\"shop_prod_agent\",\"label\":\"Shop Prod Agent\"},{\"label\":\"Answering Service Care Prod Agent\",\"key\":\"answering_service_prod_agent\"},{\"key\":\"spellbook_prod_agent\",\"label\":\"Spellbook Prod Agent\"},{\"key\":\"booking_prod_agent\",\"label\":\"Booking.com Prod Agent\"},{\"key\":\"hilton_prod_agent\",\"label\":\"Hilton Prod Agent\"},{\"label\":\"Geico Prod Agent\",\"key\":\"geico_test_agent\"},{\"label\":\"LegalZoom Prod Agent\",\"key\":\"legalzoom_prod_agent\"},{\"key\":\"the_feed_prod_agent\",\"label\":\"The Feed Prod Agent\"},{\"key\":\"brilliant_earth_prod_agent\",\"label\":\"Brilliant Earth Prod Agent\"},{\"key\":\"angi_prod_agent\",\"label\":\"Angi Prod Agent\"},{\"label\":\"Shopify SMB Prod Agent\",\"key\":\"shopify_smb_prod_agent\"},{\"key\":\"canva_print_prod_agent\",\"label\":\"Canva Print Prod Agent\"},{\"key\":\"budget_direct_prod_agent\",\"label\":\"Budget Direct Prod Agent\"},{\"label\":\"Lowes Prod Agent\",\"key\":\"lowes_prod_agent\"},{\"key\":\"image_card_v2_personalized_ads_mvp_2_composer_pinned\",\"label\":\"Personalized: Composer Pinned (Server)\"},{\"key\":\"pending_carousel_square\",\"label\":\"Pending: Carousel 1:1 — 4 images\"},{\"label\":\"Pending: Slideshow 16:9 — 4 images\",\"key\":\"pending_slideshow_landscape\"},{\"key\":\"travel_feed_carousel\",\"label\":\"Travel Feed: Variant A — Rating on image\"},{\"key\":\"travel_feed_variant_b\",\"label\":\"Travel Feed: Variant B — Title and price\"},{\"label\":\"Travel Feed: Variant C — Rating below title\",\"key\":\"travel_feed_variant_c\"},{\"key\":\"travel_feed_single\",\"label\":\"Travel Feed: Single hotel\"},{\"key\":\"travel_feed_ten_point\",\"label\":\"Travel Feed: Ten-point rating\"},{\"label\":\"Travel Feed: Sparse metadata\",\"key\":\"travel_feed_sparse_metadata\"}]},\"is_device_based\":false,\"passed\":false},\"874923992\":{\"name\":\"874923992\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3333071866\":{\"name\":\"3333071866\",\"rule_id\":\"4kPI1bhuuaWmfMGKacBGKo\",\"secondary_exposures\":[{\"gate\":\"1859514078\",\"gateValue\":\"true\",\"ruleID\":\"6r6LVMJTYYmSqi2csuF3f6\"}],\"version\":90,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"253674224\":{\"name\":\"253674224\",\"rule_id\":\"1x97F18ad8ABZ5TJpH9rQ1:100.00:1-1x97EZt7KQr7FGlNOzdOwZ\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"eligible\":true,\"launch_date\":\"2026-07-09T17:00:00.000Z\",\"duration_seconds\":1209600},\"is_device_based\":false,\"passed\":true},\"3282868491\":{\"name\":\"3282868491\",\"rule_id\":\"2HlyCvw6bnJY8OJCje8QNB:100.00:1\",\"secondary_exposures\":[],\"version\":19,\"id_type\":\"userID\",\"value\":{\"short_text\":\"Sources\",\"pill_text\":\"Add Sources\"},\"is_device_based\":false,\"passed\":true},\"3583985244\":{\"name\":\"3583985244\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":66,\"id_type\":\"workspace_id\",\"value\":{\"permissions\":[{\"permission\":\"chatgpt.workspace.model.GPT-4.1.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.1-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.5.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-pro.access\"},{\"disable_for_quorum\":true,\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1-pro.a